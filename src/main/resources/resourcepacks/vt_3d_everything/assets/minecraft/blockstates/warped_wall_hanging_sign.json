{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "vanilla_tweaks:block/warped/hanging/chains_straight"
      }
    },

    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "vanilla_tweaks:block/warped/hanging/chains_straight",
        "y": 90
      }
    },

    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "vanilla_tweaks:block/warped/hanging/chains_straight",
        "y": 180
      }
    },

    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "vanilla_tweaks:block/warped/hanging/chains_straight",
        "y": 270
      }
    }
  ]
}